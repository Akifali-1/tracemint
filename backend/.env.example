# Application Environment (development, staging, production)
APP_ENV=development

# Service URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection String (AsyncPG driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/tracemint

# Google OAuth 2.0 Credentials (Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App Credentials (GitHub Developer Settings)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google Gemini API Key & Model (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Session & JWT Signing Secret (Generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-secure-random-32-byte-hex-string

# GitHub Token Symmetric Encryption Key (Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tracemint.tech,https://www.tracemint.tech
